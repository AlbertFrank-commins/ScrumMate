{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "shell",
      "command": "dotnet build backend/src/ScrumMate.Api/ScrumMate.Api.csproj",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "docker: up",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": []
    }
  ]
}
